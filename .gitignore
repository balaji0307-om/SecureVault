*.egg

# Virtual environments
venv/
.venv/
env/
ENV/

# Environment variables & secrets
.env
.env.local

# Databases
*.db
*.sqlite
*.sqlite3

# Encrypted & Quarantine file storage (keep directory structure, ignore data blobs)
