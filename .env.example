# ==============================================================================
# SECUREVAULT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure strong random keys for production.
# DO NOT commit real production keys to version control!

# Flask Secret Key (used for session signing and CSRF tokens)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-very-strong-random-hex-string-at-least-64-characters

# Master Encryption Key (KEK: Key Encryption Key)
# Used to wrap individual file Data Encryption Keys (DEKs) using AES-256-GCM.
# Must be exactly 32 bytes (256 bits), Base64-encoded.
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
MASTER_ENCRYPTION_KEY=replace-with-32-byte-base64-encoded-key-AAAAAAAAAAAAAAAAAAAAAA==

# Database Connection URL (SQLite default, easily switched to PostgreSQL)
# SQLite: sqlite:///securevault.db
# PostgreSQL: postgresql://username:password@localhost:5432/securevault
DATABASE_URL=sqlite:///securevault.db

# Storage Directory for Encrypted Files (Blobs stored by UUID, outside web root)
STORAGE_DIR=storage/encrypted

# File Upload Constraints (Max size in megabytes)
MAX_CONTENT_LENGTH_MB=25

# Rate Limiting & Account Security
LOGIN_RATE_LIMIT=5/minute
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Server Environment (development / production)
FLASK_ENV=development
DEBUG=True
PORT=5000

